# Copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=sk-...

# Optional: Cohere reranking (falls back to SBERT if not set)
# COHERE_API_KEY=...

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=...

# Optional overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# CHROMA_DIR=data/chroma
# BM25_PATH=data/bm25.pkl
# MANIFEST_PATH=data/manifest.json

# Retrieval cache (falls back to no-cache if Redis is unavailable)
# REDIS_URL=redis://localhost:6379

# Query transformation: set to false for faster/cheaper CI runs
# ENABLE_QUERY_TRANSFORM=true
